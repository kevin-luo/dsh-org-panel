{
  "name": "dsh-org-panel",
  "version": "1.1.0",
  "description": "「纯牛马」—— DeepSeek Harness 多智能体数字员工指挥台插件：可视化真实 subagent/workflow 派活，提供可筛选员工工位与可交互群聊",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "cordis.example.yml"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsdown": "^0.3.0",
    "@types/react": "^18.3.0"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/client.tsx",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "multi-agent",
    "subagent",
    "workflow",
    "visualization",
    "orchestration",
    "digital-employees"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevin-luo/dsh-org-panel.git"
  },
  "homepage": "https://github.com/kevin-luo/dsh-org-panel#readme",
  "license": "MIT"
}
