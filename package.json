{
  "name": "dsh-org-panel",
  "version": "1.0.0",
  "description": "「纯牛马」—— 多智能体数字员工指挥台插件：从真实派活提炼老板指令、员工任务进度与交付结果，游戏化办公室看板 + 手机群聊",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/index.d.ts",
    "lib/client.d.ts"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsdown": "^0.3.0",
    "@types/react": "^18.3.0"
  },
  "scripts": {
    "build": "tsdown"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "multi-agent",
    "subagent",
    "visualization",
    "orchestration"
  ],
  "license": "MIT"
}
